// Database schema for Ember & Oak Coffee Roasters.
// Money is always stored as integer cents to avoid floating-point rounding.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  COFFEE
  BUNDLE
  ACCESSORY
}

enum RoastLevel {
  LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

enum Acidity {
  LOW
  MEDIUM
  HIGH
}

enum BrewMethod {
  ESPRESSO
  FILTER
  FRENCH_PRESS
  COLD_BREW
}

model Product {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  type         ProductType
  tagline      String
  description  String
  priceCents   Int
  stock        Int
  weightGrams  Int?
  origin       String?
  region       String?
  process      String?
  tastingNotes String[]
  roastLevel   RoastLevel?
  acidity      Acidity?
  brewMethods  BrewMethod[]
  imageUrl     String
  imageAlt     String
  featured     Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([type])
  @@index([roastLevel])
}
