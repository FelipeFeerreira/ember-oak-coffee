// Database schema for Ember & Oak Coffee Roasters.
// Money is always stored as integer cents to avoid floating-point rounding.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductType {
  COFFEE
  BUNDLE
  ACCESSORY
}

enum RoastLevel {
  LIGHT
  MEDIUM
  MEDIUM_DARK
  DARK
}

enum Acidity {
  LOW
  MEDIUM
  HIGH
}

enum BrewMethod {
  ESPRESSO
  FILTER
  FRENCH_PRESS
  COLD_BREW
}

model Product {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  type         ProductType
  tagline      String
  description  String
  priceCents   Int
  stock        Int
  weightGrams  Int?
  origin       String?
  region       String?
  process      String?
  tastingNotes String[]
  roastLevel   RoastLevel?
  acidity      Acidity?
  brewMethods  BrewMethod[]
  imageUrl     String
  imageAlt     String
  featured     Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orderItems   OrderItem[]
  recommendations ChatRecommendation[]

  @@index([type])
  @@index([roastLevel])
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_REVIEW
  EXPIRED
  SHIPPED
  DELIVERED
}

model Order {
  id                String      @id @default(cuid())
  number            String      @unique
  checkoutKey       String      @unique
  requestHash       String
  status            OrderStatus @default(PENDING)
  email             String?
  customerName      String?
  shippingAddress   Json?
  stripeSessionId   String?     @unique
  paymentIntentId   String?     @unique
  subtotalCents     Int
  shippingCents     Int
  totalCents        Int
  currency          String      @default("usd")
  checkoutOrigin    String
  trackingNumber    String?
  paidAt            DateTime?
  emailSentAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
  events            StripeEvent[]

  @@index([email, number])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  name           String
  grind          String?
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
}

// The event and its business changes commit together, or neither commits.
model StripeEvent {
  id          String   @id
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  processedAt DateTime @default(now())
}

// Shared across serverless instances; no customer email or raw IP is stored here.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model Conversation {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  messageCount    Int      @default(0)
  costMicrousd    Int      @default(0)
  activeRequestId String?
  leaseUntil      DateTime @default(now())
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        ChatMessage[]
  leads           Lead[]

  @@index([createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId       String
  role            ChatRole
  content         String
  topic           String?
  createdAt       DateTime     @default(now())
  recommendations ChatRecommendation[]

  @@unique([conversationId, requestId, role])
  @@index([conversationId, createdAt])
}

model ChatRecommendation {
  id            String      @id @default(cuid())
  messageId     String
  message       ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  addedToCartAt DateTime?
  createdAt     DateTime    @default(now())

  @@unique([messageId, productId])
  @@index([productId])
}

enum LeadStatus {
  OPEN
  CONTACTED
  CLOSED
}

// Opaque owner sessions. Raw tokens never enter the database.
model AdminSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  secretHash String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
}

model Lead {
  id             String        @id @default(cuid())
  requestId      String        @unique
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  name           String
  email          String
  question       String
  status         LeadStatus    @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
}

// A successful UTC day is recorded in the same transaction as its cleanup.
model DemoCleanupRun {
  day                  String   @id
  completedAt          DateTime @default(now())
  cutoff               DateTime
  deletedOrders        Int      @default(0)
  deletedLeads         Int      @default(0)
  deletedConversations Int      @default(0)
  restoredProducts     Int      @default(0)
}
