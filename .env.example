# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is ignored by git.

# --- Database ---------------------------------------------------------------
# Local: the Docker Compose Postgres (see docker-compose.yml).
# Production: a Neon connection string (use the pooled URL).
DATABASE_URL="postgresql://ember:ember@localhost:5433/ember_oak"

# --- Site -------------------------------------------------------------------
# Public base URL, used for Stripe redirect URLs and absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
