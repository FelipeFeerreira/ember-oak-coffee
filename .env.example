# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is ignored by git.

# Private owner dashboard: generate locally with npm run admin:token.
# Use a cryptographically random value of 32–256 characters; never expose it in URLs.
# Blank or short values disable owner access. Changing this revokes existing sessions.
ADMIN_TOKEN=""

# --- Database ---------------------------------------------------------------
# Local: the Docker Compose Postgres (see docker-compose.yml).
# Production: a Neon connection string (use the pooled URL).
DATABASE_URL="postgresql://ember:ember@localhost:5433/ember_oak"

# --- Site -------------------------------------------------------------------
# Public base URL, used for Stripe redirect URLs and absolute links.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# --- Payments (test mode only) -----------------------------------------------
# Stripe Dashboard > Test mode > API keys. Never use a live key for this demo.
STRIPE_SECRET_KEY=""
# From: stripe listen --forward-to localhost:3100/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# --- Confirmation email ------------------------------------------------------
# Leave empty to log confirmation emails locally without sending anything.
RESEND_API_KEY=""
# Use a verified sender when enabling Resend; no domain is configured by this app.
RESEND_FROM="Ember & Oak <onboarding@resend.dev>"

# --- Integration tests -------------------------------------------------------
# Must be a LOCAL database with a name ending in _test; never use production.
TEST_DATABASE_URL="postgresql://ember:ember@localhost:5433/ember_oak_test"

# --- AI shopping assistant ---------------------------------------------------
# Leave empty for the friendly offline message. Configure only after approval.
ANTHROPIC_API_KEY=""
# The model is pinned to claude-haiku-4-5-20251001 in src/lib/chat/constants.ts.
# Set an Anthropic monthly spending limit before enabling a public demo.
